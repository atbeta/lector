node_modules/
dist/
*.log
.DS_Store

# 本仓库只用 Bun 工作区：bun.lock 是唯一 lockfile。
# 别的包管理器的 lockfile 一个都不留——它们不认 packages/* 工作区，
# 照它装出来的 node_modules 缺 workspace 依赖（2026-09 踩过：
# 一个被误提交的 pnpm-lock.yaml 让 vite 报 "Failed to resolve import"）。
pnpm-lock.yaml
package-lock.json
yarn.lock

# Tauri
clients/tauri/target/
clients/tauri/gen/
# 本机校验用的临时 CARGO_TARGET_DIR（cargo 产物动辄上百 MB，绝不入库）
.cargo-check*/

# 本机性能测试夹具（脚本生成，勿入库）
perf-fixtures/

# 本机环境
.env
# 验证工具的本地产物：截图、Chrome/Playwright profile、浏览器二进制
.shots/
.tmp/
.chrome-profile/
.push.log
.gh-cache/

# 本机 CI 排障日志
.runlog.txt
.runid
.review/

# 本机 AI 编码工具的产物。Kilo 会往 .git/info/exclude 里写一份，但那是每个 clone
# 各写一次的本地文件；仓库里再兜一层，换台机器也不会把 worktree 提进来。
.kilo/
.kilocode/
# 本机真机渲染探针（WKWebView 截图、一次性 swift 脚本）。macOS 原生渲染差异只能在
# 真 WKWebView 里量，但那是一次性证据，不进仓库。
.probe/

# 立项包:开发过程中的 brief / research / bootstrap / handoff / acceptance 等本地笔记,
# 正式发布不进仓库——AGENTS.md / README.md / CHANGELOG.md 才是对外的产品文档。
.ai/
