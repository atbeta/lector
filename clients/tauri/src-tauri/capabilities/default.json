{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    { "identifier": "fs:read-files", "allow": [{ "path": "**" }] },
    { "identifier": "fs:read-meta", "allow": [{ "path": "**" }] },
    { "identifier": "fs:write-files", "allow": [{ "path": "**" }] }
  ]
}
