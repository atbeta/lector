{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lector",
  "version": "0.32.0",
  "identifier": "com.lector.reader",
  "build": {
    "beforeDevCommand": "cd packages/editor && bun run dev",
    "beforeBuildCommand": "cd packages/editor && bun run build",
    "frontendDist": "../../../packages/editor/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: lector-file: http://lector-file.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost http://localhost:5173 ws://localhost:5173; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["md", "markdown", "txt"], "name": "Markdown", "role": "Editor", "mimeType": "text/markdown" }
    ],
    "resources": {
      "icons/markdown.ico": "resources/markdown.ico"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  }
}
