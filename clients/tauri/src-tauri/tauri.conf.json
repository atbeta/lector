{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lector",
  "version": "0.1.0",
  "identifier": "com.lector.reader",
  "build": {
    "beforeDevCommand": "cd packages/editor && bun run dev",
    "beforeBuildCommand": "cd packages/editor && bun run build",
    "frontendDist": "../../../packages/editor/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Lector",
        "label": "main",
        "width": 900,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 16, "y": 18 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: lector-file: http://lector-file.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost http://localhost:5173 ws://localhost:5173; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["md", "markdown", "txt"], "name": "Markdown", "role": "Editor", "mimeType": "text/markdown" }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
